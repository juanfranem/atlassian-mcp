{
  "name": "atlassian-mcp",
  "version": "0.1.0",
  "description": "MCP server for Atlassian (Jira & Confluence) — read-only, TypeScript",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "atlassian-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "setup": "tsx src/index.ts setup"
  },
  "keywords": [
    "mcp",
    "atlassian",
    "jira",
    "confluence"
  ],
  "author": "Juanfran",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.15.2",
    "dotenv": "^17.4.2",
    "smol-toml": "^1.6.1",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.5"
  }
}
