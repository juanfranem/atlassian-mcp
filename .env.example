# =============================================================================
# Atlassian MCP Server — Environment Variables
# =============================================================================

# -----------------------------------------------------------------------------
# JIRA Configuration
# Set JIRA_URL to enable Jira tools.
# -----------------------------------------------------------------------------

JIRA_URL=https://your-company.atlassian.net
# Cloud: username (email) + API token
JIRA_USERNAME=your.email@company.com
JIRA_API_TOKEN=your_jira_api_token

# Server/DC: Personal Access Token (alternative to username + api token)
# JIRA_PERSONAL_TOKEN=your_personal_access_token

# Optional: filter tools to specific projects (comma-separated keys)
# JIRA_PROJECTS_FILTER=PROJ,DEV,OPS

# Optional: override SSL verification (default: true)
# JIRA_SSL_VERIFY=false

# Optional: override request timeout in ms (default: 30000)
# JIRA_TIMEOUT_MS=60000

# -----------------------------------------------------------------------------
# Confluence Configuration
# Set CONFLUENCE_URL to enable Confluence tools.
# -----------------------------------------------------------------------------

CONFLUENCE_URL=https://your-company.atlassian.net/wiki
# Cloud: username (email) + API token
CONFLUENCE_USERNAME=your.email@company.com
CONFLUENCE_API_TOKEN=your_confluence_api_token

# Server/DC: Personal Access Token
# CONFLUENCE_PERSONAL_TOKEN=your_personal_access_token

# Optional: filter tools to specific spaces (comma-separated keys)
# CONFLUENCE_SPACES_FILTER=DEV,DOCS,TEAM

# Optional: override SSL verification (default: true)
# CONFLUENCE_SSL_VERIFY=false

# Optional: override request timeout in ms (default: 30000)
# CONFLUENCE_TIMEOUT_MS=60000

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------

# Transport: stdio | sse | streamable-http (default: stdio)
TRANSPORT=stdio

# Port for sse/streamable-http transports (default: 8000)
PORT=8000

# Host for sse/streamable-http transports (default: 0.0.0.0)
HOST=0.0.0.0

# Read-only mode — always true; no write tools are registered (default: true)
READ_ONLY_MODE=true

# Log level: error | warn | info | debug (default: warn)
LOG_LEVEL=warn

# -----------------------------------------------------------------------------
# Proxy Configuration (optional)
# -----------------------------------------------------------------------------

# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=https://proxy.example.com:8443
